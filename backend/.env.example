# Sao chép file này thành backend/.env (đã nằm trong .gitignore) rồi điền giá trị thật.
# Trên Render: đặt các biến này trong Dashboard > Environment, KHÔNG commit giá trị thật.

APP_ENV=development

# Cơ sở dữ liệu (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quanlytrungtamgiasu
DB_USER=root
DB_PASSWORD=
# Tùy chọn: đường dẫn file chứng chỉ CA (vd. Aiven ca.pem) để bật kiểm tra chứng chỉ SSL
DB_SSL_CA=

# JWT - BẮT BUỘC đặt ở production, dùng chuỗi ngẫu nhiên dài (>= 32 byte).
# Nếu để trống, mỗi lần khởi động ứng dụng sẽ sinh khóa mới và mọi token cũ mất hiệu lực.
JWT_SECRET_KEY=
# Thời hạn token đăng nhập, tính bằng giây (mặc định 86400 = 24 giờ)
JWT_EXPIRE_TIME=86400

# Email gửi OTP / thông báo (PHPMailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Địa chỉ frontend (dùng cho CORS), ví dụ https://ten-mien-cua-ban.vercel.app
FRONTEND_URL=

# Chỉ dùng trên Render (xem render.yaml)
DISPLAY_ERRORS=0
LOG_ERRORS=1
